# Copy to .env and set strong values before docker compose up.
WETLABDB_MODE=remote
MONGO_URI=mongodb://mongo:27017
WETLABDB_DATA_DIR=/data
# At least 32 characters; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WETLABDB_SESSION_SECRET=
WETLABDB_ADMIN_USER=admin
WETLABDB_ADMIN_PASSWORD=
# Behind HTTPS in production:
# WETLABDB_SESSION_HTTPS_ONLY=1
# WETLABDB_SESSION_SAME_SITE=lax
# Search / chem bounds (see docs/p2-search-chem-limits.md):
# WETLABDB_SEARCH_MAX_COMPOUNDS=50000
# WETLABDB_CHEM_WALL_TIMEOUT_SEC=120
